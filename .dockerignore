# 构建上下文排除项：镜像里只需要代码与示例，不需要本地状态与监控目标
node_modules
.git
.gitignore

# 运行期状态（容器里用 /state 卷）
data.json
panel.html
check-report.json
fix-result.json
history/
logs/
state/

# 本地私有配置
config.json
config.local.json
.env
.DS_Store
*.log

# 只向构建器发送公开工具文档
docs/*
!docs/README.md
!docs/UIUX.md
!docs/DEPLOY.md
!docs/PUBLISHING.md
