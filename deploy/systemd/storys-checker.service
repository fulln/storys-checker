[Unit]
Description=Storys Checker 视频生产控制台
Documentation=https://github.com/fulln/storys-checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 按实际部署路径修改这两行 ----
User=storys
Group=storys
WorkingDirectory=/opt/storys-checker

ExecStart=/usr/bin/node serve.mjs

# 建议用独立的 env 文件保存密码，权限 600：
#   /etc/storys-checker.env
#     PORT=8787
#     HOST=127.0.0.1
#     STORYS_CHECKER_USER=admin
#     STORYS_CHECKER_PASSWORD=...
#     STORYS_CHECKER_READONLY=1
EnvironmentFile=-/etc/storys-checker.env

# 运行期状态放到 systemd 管理的目录（自动创建、重启保留）
Environment=STORYS_CHECKER_STATE_DIR=/var/lib/storys-checker
StateDirectory=storys-checker
StateDirectoryMode=0750

Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# 只允许写状态目录；代码目录保持只读，升级只需替换文件
ReadWritePaths=/var/lib/storys-checker
# 被监控项目通常在 home 下，只读访问即可
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
