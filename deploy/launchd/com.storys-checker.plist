<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd 常驻部署（用户级 agent，无需 root）

  安装：
    1) 把仓库放到当前用户可写的固定路径，例如 ~/opt/storys-checker（不要用 root 所有的 /opt）
    2) mkdir -p ~/opt/storys-checker/state/logs
    3) 修改下面 3 处：node 路径、WorkingDirectory、STORYS_CHECKER_STATE_DIR
    4) cp deploy/launchd/com.storys-checker.plist ~/Library/LaunchAgents/
    5) launchctl load ~/Library/LaunchAgents/com.storys-checker.plist

  查看日志：tail -f ~/opt/storys-checker/state/logs/server.log
  卸载：launchctl unload ~/Library/LaunchAgents/com.storys-checker.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.storys.checker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>serve.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/opt/storys-checker</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>HOST</key>
    <string>127.0.0.1</string>
    <key>PORT</key>
    <string>8787</string>
    <key>STORYS_CHECKER_STATE_DIR</key>
    <string>/opt/storys-checker/state</string>
    <!-- 需要账号密码时取消注释（launchd 里不要放明文密码到版本库） -->
    <!-- <key>STORYS_CHECKER_USER</key><string>admin</string> -->
    <!-- <key>STORYS_CHECKER_PASSWORD</key><string>替换为自己的强密码</string> -->
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/opt/storys-checker/state/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/storys-checker/state/logs/server.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
